# Backend API URL
# Development: Leave blank or use /api (Vite proxy handles it)
# Production: https://your-api-domain.onrender.com/api
VITE_API_URL=/api

# Optional release identifier attached to frontend runtime error telemetry
# Example: 2026.04.20-rc1
VITE_APP_RELEASE=

# Optional Gemini API key used by Learner Assist. Do not commit a real key.
VITE_GEMINI_API_KEY=
