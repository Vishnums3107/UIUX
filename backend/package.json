{
  "name": "tamil-learning-backend",
  "version": "1.0.0",
  "description": "Behavior-Driven Adaptive Tamil Learning Platform - Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "drill:restore": "node scripts/restoreDrill.js",
    "verify:deploy": "node scripts/verifyDeployment.js",
    "baseline:load": "node scripts/loadBaseline.js",
    "test": "node --test",
    "test:contracts": "node --test tests/integration.openapi-contract.test.js",
    "test:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 60 --functions 60 --branches 50 --statements 60 node --test",
    "lint": "eslint . --ext .js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "nodemailer": "^10.0.10"
  },
  "devDependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "c8": "^11.0.0",
    "eslint": "^10.0.3",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2"
  }
}
