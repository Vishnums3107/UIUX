# Server port
PORT=5000

# MongoDB connection string
# Local: mongodb://127.0.0.1:27017/tamil-learning
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/tamil-learning?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tamil-learning

# JWT Secret Key (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Token Expiration
JWT_EXPIRE=7d

# Frontend URL for CORS (use * for development, specific domain for production)
# For multiple origins, use comma-separated values in production.
FRONTEND_URL=http://localhost:5173

# Optional: set trust proxy when behind reverse proxies/load balancers (e.g., Render/Railway)
# TRUST_PROXY=1

# Optional password reset URL base (token will be appended)
# Example: https://your-app.vercel.app/resetpassword
PASSWORD_RESET_URL=http://localhost:5173/resetpassword

# SMTP configuration for password reset emails (required in production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Tamil Learning Platform

# Auth hardening (route-specific rate limiting + account lockout)
AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_FORGOT_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_FORGOT_RATE_LIMIT_MAX=6
AUTH_RESET_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RESET_RATE_LIMIT_MAX=10
AUTH_LOCKOUT_ENABLED=true
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Alerting thresholds (structured logging-based alerts)
ALERT_5XX_THRESHOLD=20
ALERT_5XX_WINDOW_SECONDS=300
ALERT_AUTH_FAILURE_THRESHOLD=25
ALERT_AUTH_FAILURE_WINDOW_SECONDS=600
ALERT_COOLDOWN_SECONDS=300
# Optional webhook for alert forwarding (Slack/Teams/custom endpoint)
# ALERT_WEBHOOK_URL=https://hooks.example.com/alerts

# Readiness checks
# In production, email readiness is required. Set READINESS_EMAIL_VERIFY=true
# to actively verify SMTP transport with a lightweight connection test.
READINESS_EMAIL_VERIFY=true
READINESS_EMAIL_VERIFY_TIMEOUT_MS=2500
